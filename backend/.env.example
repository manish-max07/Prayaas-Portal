# Server Configuration
PORT=5000
NODE_ENV=development

# Database Connection
# Replace with your actual MongoDB connection string (Atlas URI or local)
MONGO_URI=your_mongodb_connection_string_here

# JWT Configuration
# Replace with a long, random secret string (minimum 32 characters recommended)
JWT_SECRET=replace_with_a_long_random_secret_string_here
JWT_EXPIRE=7d

# Default Admin Credentials for Seeding (used only by: node src/utils/seedAdmin.js)
# Choose a strong username and password — these are written to your DB on first seed
ADMIN_DEFAULT_USERNAME=replace_with_admin_username
ADMIN_DEFAULT_PASSWORD=replace_with_a_strong_password

# Frontend Client URL (for CORS) — set this to your Vercel URL after deployment
# Example: https://prayaas-portal.vercel.app
FRONTEND_URL=http://localhost:3000
