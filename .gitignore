# Root-level .gitignore

# Environment variables — NEVER commit real secret files
.env
.env.*
.env.local
.env.development
.env.test
.env.production
!.env.example
!.env*.example

# Dependencies
node_modules/

# Production & Build outputs
.next/
out/
build/
dist/
coverage/

# OS-generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Editor directories
.vscode/
.idea/
*.swp
*.swo

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

